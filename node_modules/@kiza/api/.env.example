# Copy to .env and adjust. Never commit .env.

# Network: 0.0.0.0 listens on every interface so the three scanner phones can reach it over Kiza's Wi-Fi.
KIZA_HOST=0.0.0.0
KIZA_PORT=4000

# Where the SQLite database (kiza.db) and student photos live. Keep it on a reliable disk.
KIZA_DATA_DIR=./data
# Backups (VACUUM INTO snapshots + photo copies). Put this on a second disk or USB drive if possible.
KIZA_BACKUP_DIR=./backups
KIZA_BACKUP_INTERVAL_HOURS=6
KIZA_BACKUP_KEEP=30

# Seconds a meal-pass QR stays acceptable after the student's phone generated it.
KIZA_QR_MAX_AGE_SECONDS=90

# Sessions
KIZA_STAFF_SESSION_HOURS=14
KIZA_STUDENT_SESSION_DAYS=60

# Development helpers (/dev/qr test page). MUST be 0 in production.
KIZA_DEV_TOOLS=0
NODE_ENV=development
